# listing-forge configuration
# All values below are optional; sane defaults are in src/estate/_compat.py.
# Copy this file to .env and fill in what you need.

# Master switch (kept for parity with the original host app; standalone this
# package has no other mode).
ESTATE_ENABLED=true

# Item ID prefix. IDs look like IT-202608-001.
ESTATE_ID_PREFIX=IT

# Where photos and per-item directories live. Must be writable by the process
# and included in your backups.
ESTATE_INVENTORY_DIR=./data/inventory

# Where the standalone SQLite database file lives (see src/estate/_compat.py).
ESTATE_DATABASE_PATH=./data/listing_forge.db

# Vision provider for photo identification: mock | anthropic | openai
# mock requires no key and produces clearly-labelled placeholder output.
ESTATE_VISION_PROVIDER=mock
# Optional model override; blank uses the provider default.
ESTATE_VISION_MODEL=

# Comparable-research provider: manual_queue is the only implemented option.
# No paid or automated research source is wired into this codebase by design
# -- see src/estate/research_provider.py. Do not set this to anything else.
ESTATE_RESEARCH_PROVIDER=manual_queue

# Telegram numeric user IDs allowed to SUBMIT items, comma-separated.
ESTATE_ALLOWED_SUBMITTER_IDS=
# Telegram numeric user IDs allowed to APPROVE prices. Empty = submitters only.
ESTATE_REVIEWER_IDS=

# Shared token for the review web interface at /estate/review.
# REQUIRED for the review UI. If unset, every review route returns 401 - the
# interface fails closed rather than open. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The review UI has no other authentication. Bind it to 127.0.0.1 and reach
# it over an SSH tunnel; do not put it on a public URL.
ESTATE_REVIEW_TOKEN=

# Hard move-out / disposition deadline, YYYY-MM-DD. Drives markdown urgency.
# Falls back to config/pricing.json -> deadline.move_out_date if unset.
ESTATE_MOVE_OUT_DATE=

# Dedicated selling email address. See docs/BUYER_INBOX.md.
ESTATE_SELLING_EMAIL=

# Public catalogue URL, included in listing copy and buyer replies.
ESTATE_CATALOG_URL=

# Catalogue display name shown to buyers.
ESTATE_BRAND_NAME=The Collection

# Region shown to buyers, e.g. "the Portland area". NEVER the street address.
ESTATE_PICKUP_REGION=

# Optional: path to the tunable pricing config.
# ESTATE_PRICING_CONFIG=config/pricing.json

# ---------------------------------------------------------------------------
# Public inquiry endpoint (a serverless function, NOT the main process)
# ---------------------------------------------------------------------------
# These are set on the *hosting platform* for the public catalogue (e.g.
# Vercel project -> Settings -> Environment Variables), not in this file.
# They are listed here so the full set of required secrets is documented in
# one place.
#
# The bot that delivers buyer inquiries to the reviewer's Telegram chat.
# Use a bot dedicated to this purpose -- create one with @BotFather (free,
# no account of any kind). A public serverless function is a wider trust
# boundary than a private server; if that environment ever leaks, it must
# not hand anyone control of anything more sensitive than inquiry delivery.
# ESTATE_INQUIRY_TELEGRAM_BOT_TOKEN=
#
# The approved reviewer's numeric Telegram chat ID -- where inquiries land.
# Message the new bot once, then read the chat id from getUpdates. Supplied
# by configuration and never by the request, so no caller can redirect an
# inquiry somewhere else.
# ESTATE_INQUIRY_TELEGRAM_CHAT_ID=
#
# Random salt for hashing visitor IPs in the inquiry audit trail. The raw IP
# is never stored. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# ESTATE_INQUIRY_IP_SALT=
#
# Only needed if the catalogue is ever served from a different origin than
# the inquiry endpoint. Left unset, no CORS grant is issued at all, which is
# correct for a same-origin deployment.
# ESTATE_SITE_ORIGIN=
#
# Optional: where the non-durable local breadcrumb log is written. Useful for
# `vercel dev`. Never treat this file as the record of an inquiry.
# ESTATE_INQUIRY_LOG_PATH=/tmp/estate_inquiries.jsonl
